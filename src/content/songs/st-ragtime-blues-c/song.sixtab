| "A7=x02020" e (5:0{P} 1:3{M 4}) 1:0{M} (4:2{P 1} 2:2{I 2}) 1:0{M} (6:0{P} 1:-) 1:3{4} (4:2 1:0) 2:2 | q (5:0 1:0) e (4:2 1:-) 2:2 (6:0 2:-) 1:0 (4:2 1:3) 1:2{3} |
| "D7=xx0212" e (4:0{P} 1:-) 2:3{I 4} (3:2{P 2} 2:1{I 1}) 2:3{4} (5:0{P} 2:-) 1:2{M 3} (3:2 1:0) 2:1 | e (4:0 2:3) 1:2 (3:2 1:-) 2:3 (5:0 2:1) 1:0 (3:2 2:1) 2:0 |
| "G7=320001" e (6:3{P 3} 2:-) 2:3{I 4} (4:0{P} 1:1{M 1}) 2:3{4} (5:2{P 2} 2:-) 2:0{I} (4:0 3:0{I}) 2:0 | q (6:3 1:1) e (4:0 2:3) 2:0 (5:2 2:-) 3:0 (4:0 2:3) 2:4{4} |
[Second time]
| "C=x32010" e (5:3 1:0) 1:3 (4:2 1:0) 1:3 (6:3 1:-) 1:0 (4:2 2:3) 2:1 | q (5:3 2:1) e (4:2 1:0) 1:3 (6:3 1:-) 1:0 (4:2 2:1) 2:2{3} |
